{
  "name": "nok-2025-v1",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postbuild": "xcopy build\\*.* . /E /H /Y",
    "build": "wp-scripts build --output-path=build",
    "start": "wp-scripts start --output-path=build",
    "css:build": "sass assets/css/nok-components.scss assets/css/nok-components.css --style=expanded --source-map",
    "css:extract-atf": "node scripts/extract-atf-css.mjs",
    "css:critical:legacy": "sass assets/css/nok-critical.scss assets/css/nok-critical.css --style=compressed --no-source-map",
    "css:all": "npm run css:build && npm run css:extract-atf",
    "icons:normalize": "node normalize-icons.js",
    "icons:watch": "nodemon --watch assets/icons-source --ext svg --exec npm run icons:normalize",
    "vendor:chartjs": "node -e \"const fs=require('fs');fs.mkdirSync('assets/js/lib',{recursive:true});fs.copyFileSync('node_modules/chart.js/dist/chart.umd.js','assets/js/lib/chart.umd.js');\"",
    "postinstall": "npm run vendor:chartjs",
    "css:chart": "sass assets/css/components/nok-chart.scss assets/css/components/nok-chart.css --style=expanded --no-source-map && sass assets/css/components/nok-chart.scss assets/css/components/nok-chart.min.css --style=compressed --no-source-map"
  },
  "devDependencies": {
    "@wordpress/scripts": "^32.4.0",
    "autoprefixer": "^10.5.0",
    "csso": "^5.0.5",
    "csso-cli": "^4.0.2",
    "google-closure-compiler": "^20240317.0.0",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.0",
    "sass": "^1.100.0",
    "svgo": "^4.0.0"
  },
  "dependencies": {
    "@wordpress/data": "^10.48.0",
    "@wordpress/dom-ready": "^4.48.0",
    "@wordpress/icons": "^13.3.0",
    "chart.js": "^4.4.0"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.7",
    "axios": "^1.17.0",
    "basic-ftp": "^6.0.1",
    "fast-uri": "^3.1.2",
    "follow-redirects": "^1.16.0",
    "ip-address": "^10.2.0",
    "lodash": "^4.18.1",
    "minimatch": "^3.1.5",
    "qs": "^6.15.2",
    "serialize-javascript": "^7.0.5",
    "uuid": "11.1.1",
    "webpack-dev-server": "^5.2.4",
    "ws": "^8.21.0"
  }
}
